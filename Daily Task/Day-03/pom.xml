<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hcl.daily</groupId>
    <artifactId>day-03-atm-simulator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Day 03 - ATM Simulator and Control Flow</name>
    <description>Daily hands-on ATM simulator demonstrating control flow and Maven profiles</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <app.environment>default</app.environment>
        <atm.daily.limit>25000.00</atm.daily.limit>
        <atm.fee.percentage>0.01</atm.fee.percentage>
        <debug.mode>false</debug.mode>
    </properties>

    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <app.environment>dev</app.environment>
                <atm.daily.limit>50000.00</atm.daily.limit>
                <atm.fee.percentage>0.00</atm.fee.percentage>
                <debug.mode>true</debug.mode>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <app.environment>prod</app.environment>
                <atm.daily.limit>20000.00</atm.daily.limit>
                <atm.fee.percentage>0.02</atm.fee.percentage>
                <debug.mode>false</debug.mode>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.atm.AtmSimulator</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
