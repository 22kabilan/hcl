<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.laundry</groupId>
    <artifactId>laundry-service-management</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Laundry Service Management</name>
    <description>Enterprise laundry service management system with item-wise pricing, pickup/delivery scheduling, and production tracking.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <app.environment>default</app.environment>
    </properties>

    <!-- Parent POM ready for sub-modules if separated in future sprints -->
    <!--
    <modules>
        <module>auth-service</module>
        <module>laundry-service</module>
        <module>logistics-service</module>
    </modules>
    -->

    <dependencies>
        <!-- Standard JUnit 5 for unit testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- Executable JAR plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.laundry.app.LaundryConsoleApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Maven Profiles: dev and prod as required by Day 3 specifications -->
    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <app.environment>dev</app.environment>
                <app.logLevel>DEBUG</app.logLevel>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <app.environment>prod</app.environment>
                <app.logLevel>INFO</app.logLevel>
            </properties>
        </profile>
    </profiles>
</project>
